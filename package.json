{
  "name": "xiaobai-accounting",
  "version": "1.2.0",
  "description": "小白记账 - 个人记账桌面应用",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "cross-env ELECTRON_RUN_AS_NODE= electron-vite build",
    "preview": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview",
    "package": "cross-env ELECTRON_RUN_AS_NODE= electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"if(process.env.ELECTRON_RUN_AS_NODE){console.warn('\\n⚠️  WARNING: ELECTRON_RUN_AS_NODE is set! This will break Electron.\\n   Please remove it from your system environment variables.\\n')}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.xiaobai.accounting",
    "productName": "小白记账",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asar": false,
    "releaseInfo": {
      "releaseNotesFile": "docs/release-notes/v1.2.0.md"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2052"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HY-Louis",
        "repo": "XiaoBai-Accounting",
        "releaseType": "release"
      }
    ]
  }
}
